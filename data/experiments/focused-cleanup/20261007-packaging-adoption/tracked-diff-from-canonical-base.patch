+# Cleanup inspection must not load compiler or package configuration.
+CONTROL_GOALS := test-linux-desktop-installer test-macos-bundle-lifecycle clean clean-plan test-top-level-cleanup test-package-launcher-lifecycle
+ifneq ($(filter clean,$(MAKECMDGOALS)),)
